# Local processes
API_PORT=4000
NEXT_PUBLIC_API_URL=http://localhost:4000
DASHBOARD_ORIGIN=http://localhost:3000
DATABASE_URL=postgresql://concierge:change-me@localhost:5432/concierge
# SQLite remains available for isolated legacy tests when DATABASE_URL is unset.
DATABASE_FILE=./data/concierge.sqlite

# Collection and delivery
ARTICLES_PER_SOURCE=25
INGEST_CRON=*/30 * * * *
DELIVERY_CRON=0 */4 * * *
DELIVERY_COUNT=3
RUN_INGESTION_ON_START=false

# A high-scoring new article can be delivered immediately with this probability.
SERENDIPITY_THRESHOLD=0.88
SERENDIPITY_PROBABILITY=0.35

# Hybrid evaluation. Without the selected provider's token, the classic ranker works on its own.
RANKING_ALGORITHM=interpretable-linear-v1
LLM_PROVIDER=openai
LLM_WEIGHT=0.30
LLM_CANDIDATE_LIMIT=2

# Standard OpenAI-compatible endpoint. For the example model service use
# http://model:11434/v1 inside Compose, or your own endpoint URL.
OPENAI_BASE_URL=http://localhost:11434/v1
OPENAI_API_KEY=ollama
OPENAI_MODEL=qwen2.5:1.5b
OPENAI_MODEL_REVISION=1
OPENAI_TIMEOUT_MS=120000
# Required for the live Inference panel with PostgreSQL.
# Generate with: openssl rand -hex 24
INFERENCE_ADMIN_TOKEN=replace-with-a-random-admin-token
# Optional. 64 hex characters, or omit to derive the key from INFERENCE_ADMIN_TOKEN.
# INFERENCE_SETTINGS_KEY=

# Compose PostgreSQL credentials. Choose a strong password before deployment.
POSTGRES_USER=concierge
POSTGRES_PASSWORD=change-me
POSTGRES_DB=concierge

# Discord edge. Guilds and delivery channels are discovered at runtime.
DISCORD_BOT_TOKEN=

# Dashboard-only learning profile when Discord is not configured.
ADMIN_CHANNEL_ID=admin-preview
ADMIN_CHANNEL_NAME=dashboard-preview
