{
  "name": "news-feed-concierge",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "concurrently -k -n DASHBOARD,APP -c cyan,green \"npm:dev:dashboard\" \"npm:dev:backend\"",
    "dev:dashboard": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext dev",
    "dev:backend": "tsx watch src/entrypoints/all.ts",
    "dev:api": "tsx watch src/entrypoints/api.ts",
    "ingest": "tsx src/entrypoints/ingest.ts",
    "build": "npm run build:dashboard && npm run typecheck",
    "build:dashboard": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext build",
    "typecheck": "tsc --noEmit",
    "start": "concurrently -k -n DASHBOARD,APP \"npm:start:dashboard\" \"npm:start:backend\"",
    "start:dashboard": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext start",
    "start:backend": "tsx src/entrypoints/all.ts",
    "start:cloud-run": "node --import tsx src/entrypoints/cloud-run.ts",
    "test": "node --import tsx --test tests/*.test.ts",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "start:server": "node --import tsx src/entrypoints/server.ts",
    "db:migrate": "node --import tsx src/entrypoints/migrate.ts",
    "db:import-sqlite": "node --import tsx src/entrypoints/import-sqlite.ts",
    "test:postgres": "node --import tsx --test tests/postgres.integration.test.ts"
  },
  "dependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "better-sqlite3": "^13.0.3",
    "cheerio": "^1.2.0",
    "concurrently": "^10.0.5",
    "cors": "^2.8.6",
    "discord.js": "^14.27.0",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "node-cron": "^4.6.0",
    "openai": "^7.5.0",
    "pg": "8.16.3",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "tsx": "^4.23.12",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@eslint/js": "9.39.4",
    "@next/eslint-plugin-next": "16.2.6",
    "@openai/sites-vite-plugin": "0.1.0",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/pg": "8.15.5",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "eslint": "9.39.4",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "16.4.0",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.59.3",
    "vinext": "1.0.0-beta.2",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module"
}
