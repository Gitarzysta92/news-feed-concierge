# Copy to .env.compose and set real credentials before deployment.
POSTGRES_USER=concierge
POSTGRES_DB=concierge
# For local Compose only. Coolify generates these from the service names.
SERVICE_PASSWORD_64_DATABASE=replace-with-a-random-database-password
SERVICE_PASSWORD_64_SERVER=replace-with-a-random-admin-token
DASHBOARD_ORIGIN=http://localhost:8080
LLM_PROVIDER=openai
OPENAI_BASE_URL=http://model:11434/v1
OPENAI_API_KEY=ollama
OPENAI_MODEL=qwen2.5:1.5b
OPENAI_MODEL_REVISION=1
OPENAI_TIMEOUT_MS=120000
# Enable the optional example model service; omit when using an existing endpoint.
COMPOSE_PROFILES=local-model
DISCORD_BOT_TOKEN=
RUN_INGESTION_ON_START=false
